# Install inside an HTTPS server block with your own domain and valid certificate.
# Preserve Host; Mailnotes validates it against MAILNOTES_PUBLIC_URL.
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 180s;
    client_max_body_size 128k;
}
# Do not log OAuth callback query strings containing authorization codes.
location = /oauth/callback {
    access_log off;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $http_host;
}
