{
  "manifest_version": 3,
  "name": "Sổ ghi chép — AI Gmail",
  "version": "0.3.0",
  "description": "DeepSeek chọn thư và nút PDF trên tab Gmail đã đăng nhập. Bản thử một thư.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://mail.google.com/*", "https://*.googleusercontent.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"}
}
