{
  "manifest_version": 3,
  "name": "Sổ ghi chép — AI Gmail",
  "version": "0.4.1",
  "description": "Tự thao tác trên Gmail để xử lý tối đa 20 thư và mọi PDF đính kèm.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://mail.google.com/*", "https://*.googleusercontent.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"}
}
